    {
      "name": "receipt result/batch correlation",
      "expect": "no_op=>batch_seq null; committed=>positive"
    },
    {
      "name": "date ordering",
      "expect": "end > start and task/calendar endpoints consistent"
    },
    {
      "name": "read set closure",
      "expect": "missing empty-collection version rejected"
    },
    {
      "name": "own echo and second local edit",
      "expect": "receipt does not invent base; echo preserves newer local value"
    },
    {
      "name": "per-batch cursor",
      "expect": "first batch cannot persist whole-page end cursor"
    },
    {
      "name": "deletion lost response",
      "expect": "capability retry/status works after bearer revocation"
    },
    {
      "name": "old contract replay",
      "expect": "same frozen ID/hash/receipt across deployment"
    }
  ]
