function(daymark_generate_official_service config_file output_file)
    set(DAYMARK_OFFICIAL_ORIGIN "")
    if(EXISTS "${config_file}")
        if(IS_DIRECTORY "${config_file}")
            message(FATAL_ERROR "Local official service configuration must be a file.")
        endif()
        file(SIZE "${config_file}" _size)
        if(_size GREATER 2048)
            message(FATAL_ERROR "Local official service configuration is too large.")
        endif()
        file(READ "${config_file}" _origin)
        string(STRIP "${_origin}" _origin)
        if(NOT _origin MATCHES "^https://([A-Za-z0-9][A-Za-z0-9.-]*|\\[[0-9A-Fa-f:]+\\])(:([0-9]+))?/?$")
            message(FATAL_ERROR "Invalid local official service configuration: provide one HTTPS origin without credentials, path, query or fragment.")
        endif()
        set(_port "${CMAKE_MATCH_3}")
        if(NOT _port STREQUAL "" AND (_port LESS 1 OR _port GREATER 65535))
            message(FATAL_ERROR "Invalid local official service port.")
        endif()
        string(REGEX REPLACE "/$" "" DAYMARK_OFFICIAL_ORIGIN "${_origin}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${config_file}")
    endif()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/OfficialServiceConfig.h.in" "${output_file}" @ONLY)
endfunction()
