cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED TEST_OUTPUT)
    message(FATAL_ERROR "Explicit source and temporary output roots required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_root "${TEST_OUTPUT}/official-config-${_nonce}")
file(MAKE_DIRECTORY "${_root}")

function(check_config name content expected should_fail)
    set(_input "${_root}/${name}.txt")
    set(_output "${_root}/${name}.h")
    if(NOT name STREQUAL "missing")
        file(WRITE "${_input}" "${content}")
    endif()
    set(_driver "${_root}/${name}.cmake")
    file(WRITE "${_driver}" "include([=[${SOURCE_ROOT}/cmake/OfficialService.cmake]=])\ndaymark_generate_official_service([=[${_input}]=] [=[${_output}]=])\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_driver}" RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 10)
    if(NOT _result MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Official service validation did not finish: ${name}")
    endif()
    if(should_fail)
        if(_result EQUAL 0 OR EXISTS "${_output}")
            message(FATAL_ERROR "Invalid official service configuration was accepted: ${name}")
        endif()
        if(NOT content STREQUAL "")
            string(FIND "${_stdout}${_stderr}" "${content}" _leak)
            if(NOT _leak EQUAL -1)
                message(FATAL_ERROR "Rejected configuration was printed in diagnostics: ${name}")
            endif()
        endif()
    else()
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Valid official service configuration failed: ${name}")
        endif()
        file(READ "${_output}" _header)
        string(FIND "${_header}" "officialServiceOrigin[] = \"${expected}\";" _match)
        if(_match EQUAL -1)
            message(FATAL_ERROR "Unexpected generated official service origin: ${name}")
        endif()
    endif()
endfunction()

check_config(missing "" "" FALSE)
check_config(valid "https://official.example.invalid/\n" "https://official.example.invalid" FALSE)
check_config(port "https://official.example.invalid:9443" "https://official.example.invalid:9443" FALSE)
check_config(ipv6 "https://[::1]:9443/" "https://[::1]:9443" FALSE)
check_config(http "http://private.example.invalid" "" TRUE)
check_config(credentials "https://person:sensitive-example@private.example.invalid" "" TRUE)
check_config(path "https://private.example.invalid/v1" "" TRUE)
check_config(query "https://private.example.invalid?key=sensitive-example" "" TRUE)
check_config(fragment "https://private.example.invalid#sensitive-example" "" TRUE)
check_config(two_lines "https://private.example.invalid\nhttps://second.example.invalid" "" TRUE)
check_config(zero_port "https://private.example.invalid:0" "" TRUE)
check_config(large_port "https://private.example.invalid:65536" "" TRUE)
message(STATUS "PASS: official service configuration, missing-file fallback and private diagnostic boundaries")
